LIBRARY HDF5

DEFAULT serial

USESETUPVARS parallelIO, IO, IOWriteGridFiles, HDF5ZFP, HDF5SZ

IF HDF5ZFP
  LIBRARY ZFP
  PARAMETER zfp_accuracy REAL 0.0
  PARAMETER zfp_rate REAL 0.0
  PARAMETER zfp_precision REAL 0.0
  PARAMETER zfp_reversible REAL 0.0
ENDIF

IF HDF5SZ
  LIBRARY SZ
  PARAMETER sz_abs_error REAL 0.0
  PARAMETER sz_rel_error REAL 0.0
  PARAMETER sz_pw_rel_error REAL 0.0
  PARAMETER sz_psnr REAL 0.0
ENDIF


IF IOWriteGridFiles
  REQUIRES IO/IOMain/hdf5/writeGrid
ENDIF

IF IO not in ["","hdf5"]
   SETUPERROR The variable 'IO' is set to something other than 'hdf5'
ENDIF

IF parallelIO
   DEFAULT parallel
ENDIF

IF not fixedBlockSize
   DEFAULT parallel
ENDIF

#The following IF condition only gets triggered when the user explicitly
#tries to combine +nofbs with +serialIO or parallelIO=False.  Note: It
#didn't seem to work when nested inside the "IF not fixedBlockSize" above.
IF not parallelIO and not fixedBlockSize
   SETUPERROR No serial I/O implementation for NoFBS UG
ENDIF

EXCLUSIVE serial parallel

PPDEFINE FLASH_IO_HDF5
